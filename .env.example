# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real secrets.
# Step-by-step setup for the sign-in values: docs/auth.md

# Neon Postgres connection string (pooled). Use the `dev` branch locally.
# Neon console → Connect → pick branch → copy the connection string.
# Change `sslmode=require` at the end to `sslmode=verify-full` (the pg driver warns otherwise).
DATABASE_URL=

# Better Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (github.com → Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
